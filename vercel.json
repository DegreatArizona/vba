{
  "builds": [
    {
      "src": "vehiclebreakdown/wsgi.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "15mb", 
        "runtime": "python3.9" 
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "vehiclebreakdown/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron.py",  
      "schedule": "0 10 * * *"  
    }
  ],
  "buildCommand": "pip install -r requirements.txt"
}
